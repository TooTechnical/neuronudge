# Runtime mode: development, test, or production
APP_ENV=development

# Authentication is mandatory in production.
REQUIRE_AUTH=true
CHECK_REVOKED_TOKENS=true
FIREBASE_PROJECT_ID=your-firebase-project-id

# Comma-separated, exact origins and hosts. Wildcards are discouraged.
ALLOWED_ORIGINS=http://localhost:5000
ALLOWED_HOSTS=localhost,127.0.0.1

# Keep real credentials outside this file. Firebase Admin uses Application
# Default Credentials or a file path supplied by the hosting environment:
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# Optional, only for endpoints that call OpenAI.
OPENAI_API_KEY=
